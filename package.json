{
  "name": "api-testing-autopilot",
  "version": "1.0.0",
  "description": "Scan a codebase for undocumented API endpoints and load-test them with k6",
  "main": "index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node index.js",
    "smoke": "node scripts/smoke-grammars.js",
    "demo:up": "node examples/demo-api/server.js",
    "demo:down": "echo 'Stop the server process manually (Ctrl-C)'",
    "demo:go": "cd examples/demo-api-go && go run ."
  },
  "dependencies": {
    "@babel/parser": "^7.24.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "express": "^4.18.0",
    "simple-git": "^3.24.0",
    "tree-sitter-wasms": "^0.1.13",
    "web-tree-sitter": "^0.22.6"
  },
  "keywords": [
    "api",
    "testing",
    "k6",
    "mcp",
    "tree-sitter"
  ],
  "license": "MIT"
}
